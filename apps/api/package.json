{
  "name": "@talkytown/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "dotenv -e ../../.env -e ../../.env.example -- prisma generate --schema prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "dotenv -e ../../.env -e ../../.env.example -- prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -e ../../.env.example -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -e ../../.env.example -- prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@talkytown/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
