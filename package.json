{
  "name": "talkytown",
  "version": "0.1.0",
  "private": true,
  "description": "TalkyTown — gamified AI language learning web app for children.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "dotenv -e .env -e .env.example -- prisma generate --schema apps/api/prisma/schema.prisma",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:db": "dotenv -e .env -e .env.example -- pnpm --filter @talkytown/api exec vitest run --config vitest.database.config.ts",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "db:migrate": "dotenv -e .env -e .env.example -- prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:migrate:dev": "dotenv -e .env -e .env.example -- prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "dotenv -e .env -e .env.example -- pnpm --filter @talkytown/api exec tsx prisma/seed.ts",
    "db:verify": "dotenv -e .env -e .env.example -- pnpm --filter @talkytown/api exec tsx prisma/verify-seed.ts",
    "db:validate": "dotenv -e .env -e .env.example -- prisma validate --schema apps/api/prisma/schema.prisma",
    "db:studio": "dotenv -e .env -e .env.example -- prisma studio --schema apps/api/prisma/schema.prisma",
    "e2e": "playwright test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
