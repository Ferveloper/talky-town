# -----------------------------------------------------------------------------
# TalkyTown environment example
# Copy this file to .env for local development.
# -----------------------------------------------------------------------------

# General
NODE_ENV=development
PRISMA_HIDE_UPDATE_MESSAGE=true

# Web
NEXT_PUBLIC_APP_NAME=TalkyTown
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Database
# Docker host port; keep DATABASE_URL in sync if you change this.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://talkytown:talkytown@localhost:55432/talkytown?schema=public

# Demo seed
DEMO_USER_EMAIL=demo@talkytown.local
DEMO_USER_ALIAS=Demo Tutor

# AI provider
# Supported initial values: mock, openai-compatible-cloud, local-openai-compatible
AI_PROVIDER=mock
AI_PROVIDER_BASE_URL=http://localhost:11434/v1
AI_PROVIDER_MODEL=talkytown-mock
AI_PROVIDER_API_KEY=

# Safety
ENABLE_SAFETY_GUARDRAILS=true
STORE_RAW_AUDIO=false

# Voice
ENABLE_VOICE_INPUT=false
ENABLE_VOICE_OUTPUT=false
